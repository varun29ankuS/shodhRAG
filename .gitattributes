# Text files are stored with LF in the repository and checked out with LF.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries are never converted or diffed.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.tif binary
*.tiff binary
*.ico binary
*.icns binary
*.pdf binary
*.onnx binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.exe binary
*.dll binary
*.zip binary
