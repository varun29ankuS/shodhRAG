{
  "name": "shodh-launch-video",
  "private": true,
  "version": "1.0.0",
  "description": "Shodh launch video (Remotion): real app footage beside animated chapter titles on Shodh orange, cut to the music's bars.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ShodhLaunch out/shodh-launch.mp4 --codec=h264 --crf=18 --concurrency=2",
    "render:gif": "remotion render src/index.ts ShodhLoop out/shodh-loop.gif --codec=gif --every-nth-frame=2 --scale=0.5 --number-of-gif-loops=0 --concurrency=2",
    "beats": "python scripts/beats.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@remotion/cli": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
